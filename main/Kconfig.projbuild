menu "Keychain player"
    config KEYCHAIN_BENCHMARK_FRAMES
        int "Startup diagnostic frames without playback pacing (0 disables)"
        range 0 300
        default 0
    config KEYCHAIN_AP_SSID
        string "Wi-Fi access point name"
        default "OLED-Keychain"
    config KEYCHAIN_AP_PASSWORD
        string "Wi-Fi access point password (8 to 63 characters)"
        default "keychain123"
endmenu
